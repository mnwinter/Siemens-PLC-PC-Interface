  "training": {
    "hints": [
      "Run, then Start the preloaded carton. After home return, Load next carton and Start again.",
      "Home, attachment, release position and pick completion are plant feedback. The pallet-valid button is an operator permissive.",
      "A 750 ms pickup dwell enables vacuum. Count only completed placement plus home return, never elapsed time alone.",
      "Stop freezes the offline plant and clears commands. Run alone stays held; Start resumes. Four placements complete one retained layer."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: carton_at_pick, gantry_home, pallet_position_valid.",
        "Command the documented outputs: vacuum_pick, gantry_cycle, layer_complete.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "A carton is picked only at home and placed only at a valid pallet position."
    },
    "assetRequirements": [
      "XY gantry",
      "vacuum gripper",
      "pallet magazine",
      "carton load",
      "supported pickup table"
    ],
    "machineGuide": {
      "purpose": "Four-carton palletizing lesson: supported pickup, PLC-commanded vacuum, carried cartons, placement feedback and home return. Start one carton at a time; Reset starts a new layer.",
      "startConditions": [
        "Select the built-in offline controller; no PLC connection is required.",
        "The pickup carton is present, the gantry is home, and the pallet permissive is true."
      ],
      "normalSequence": [
        "Run, then Start the preloaded carton. After home return, Load next carton and Start again.",
        "The gantry lowers onto the carton, dwells 750 ms, picks up, carries to the next pallet slot, releases on the pallet, and returns home.",
        "Repeat Load then Start for cartons 2-4. The layer-complete lamp follows the fourth completed home return."
      ],
      "stopBehavior": [
        "Stop freezes pose and attachment, clears output commands, and preserves the placed cartons. Run then fresh Start resumes the held carton.",
        "Removing the pallet permissive freezes the cycle. Restore it and press Start to resume. Reset clears the layer and restores the preloaded pickup carton."
      ],
      "faultBehavior": [
        "Vacuum loss during commanded carry latches a fault. Reset restores the initial lesson. Offline pause retains attachment without modelling gravity."
      ],
      "expectedObservations": [
        "The pickup carton remains on a table until attached. Carried cartons follow the tool; released cartons remain on four separate pallet slots.",
        "Home is generated from the completed home return. The placement counter advances after actual release and home return."
      ]
    },
