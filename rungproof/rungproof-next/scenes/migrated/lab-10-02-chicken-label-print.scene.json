  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: A label request is issued only when the product data and printer are ready.",
      "Inputs are simulator feedback (product_weighed, printer_ready, label_data_valid); PLC logic owns print_request, label_applied.",
      "Test the initial state, the valid condition, and at least one missing permissive.",
      "The five BOOL points represent manual validity inputs and controller-owned output indications. The weigh-deck DEMO readout, printer paper and label preview are static; no actual weight or label text is processed."
    ],
    "solution": {
      "summary": "Controller requirements only; no executable reference ladder or physical weighing/printing implementation is supplied.",
      "steps": [
        "Require the documented inputs: product_weighed, printer_ready, label_data_valid.",
        "Command the documented outputs: print_request, label_applied.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "A label request is issued only when the product data and printer are ready."
    },
    "assetRequirements": [
      "food product load",
      "checkweigher",
      "label printer",
      "formatted label display"
    ],
    "machineGuide": {
      "purpose": "Boolean label-request exercise with supported food tray, weigh deck, printer and static label-preview props. No measured weight, text formatting, printing or reference controller is supplied.",
      "startConditions": [
        "Author or load a valid offline controller for the five declared BOOL points.",
        "Validity inputs begin false; the simulator shell has no live PLC transport."
      ],
      "normalSequence": [
        "Toggle product_weighed, printer_ready and label_data_valid as manual symbolic inputs.",
        "Observe controller-owned print_request and label_applied indicators; static props do not execute a product-transfer or print cycle."
      ],
      "stopBehavior": [
        "Controller logic must remove print_request when its required validity inputs are lost.",
        "Playback Stop freezes local execution; it does not write a PLC.",
        "Reset restores initial scene points."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "The five BOOL points represent manual validity inputs and controller-owned output indications. The weigh-deck DEMO readout, printer paper and label preview are static; no actual weight or label text is processed.",
        "A normal Run opens an empty editor until valid controller logic is supplied."
      ]
    },
