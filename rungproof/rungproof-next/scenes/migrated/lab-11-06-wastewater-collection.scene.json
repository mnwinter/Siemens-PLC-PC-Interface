  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: The pump and outlet valve run only when a source requires service and treatment is ready.",
      "Inputs are simulator feedback (source_level_high, treatment_ready, outlet_clear); PLC logic owns transfer_pump_run, outlet_valve_open.",
      "Test the initial state, the valid condition, and at least one missing permissive."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: source_level_high, treatment_ready, outlet_clear.",
        "Command the documented outputs: transfer_pump_run, outlet_valve_open.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "The pump and outlet valve run only when a source requires service and treatment is ready."
    },
