<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RungProof.Next</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\demo-projects\**\*.cs" />
    <!-- External verification harnesses must never be globbed into the Godot
         assembly, even if a tester accidentally stages one under the root. -->
    <Compile Remove="_agent*\**\*.cs" />
  </ItemGroup>
</Project>
