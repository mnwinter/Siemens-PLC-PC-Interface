{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rungproof.local/schema/plcscene-v1.json",
  "title": "RungProof PLC visual scene version 1",
  "type": "object",
  "required": ["version", "id", "name", "equipment", "simulation"],
  "properties": {
    "fileType": { "const": "plc-visual-scene" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/symbolicName" },
    "name": { "$ref": "#/$defs/displayText" },
    "description": { "type": "string", "maxLength": 16384 },
    "machineGuide": { "$ref": "#/$defs/machineGuide" },
    "plcTestProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
      "maxLength": 128
    },
    "equipment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/equipment" }
    },
    "simulation": { "$ref": "#/$defs/simulation" },
    "alarmRules": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "object" }
    },
    "camera": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/transformVector" },
        "target": { "$ref": "#/$defs/transformVector" },
        "fov": { "type": "number", "minimum": 1, "maximum": 179 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "symbolicName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "transformVector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -10000, "maximum": 10000 },
        { "type": "number", "minimum": -10000, "maximum": 10000 },
        { "type": "number", "minimum": -10000, "maximum": 10000 }
      ],
      "items": false
    },
    "scaleVector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": 0.001, "maximum": 100 },
        { "type": "number", "minimum": 0.001, "maximum": 100 },
        { "type": "number", "minimum": 0.001, "maximum": 100 }
      ],
      "items": false
    },
    "rangeValue": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 64 },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "number", "minimum": -1000000, "maximum": 1000000 },
            { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          ],
          "items": false
        }
      ]
    },
    "equipmentConfig": {
      "type": "object",
      "maxProperties": 32,
      "properties": {
        "action": { "$ref": "#/$defs/symbolicName" },
        "active": {
          "oneOf": [
            { "type": "null" },
            { "type": "boolean" },
            { "type": "string", "minLength": 1, "maxLength": 64 }
          ]
        },
        "angleRangeDeg": { "type": "number", "minimum": -3600, "maximum": 3600 },
        "axis": { "enum": ["x", "y", "z"] },
        "beamCenterHeightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "beamHeightsM": { "$ref": "#/$defs/scaleVector" },
        "beamRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "beltColor": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "bladeColor": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "bladeCount": { "type": "integer", "minimum": 2, "maximum": 24 },
        "blocked": { "type": "boolean" },
        "centerHeight": { "type": "number", "minimum": 0, "maximum": 100 },
        "caseDepthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "caseHeightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "caseWidthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "color": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "deckHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "depth": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "diameter": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "engineeringRange": { "$ref": "#/$defs/rangeValue" },
        "fluidColor": { "type": "integer", "minimum": 0, "maximum": 16777215 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "initialLevel": { "type": "number", "minimum": 0, "maximum": 1 },
        "initialPosition": { "type": "number", "minimum": 0, "maximum": 16 },
        "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "layers": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumAngleDeg": { "type": "number", "minimum": -3600, "maximum": 3600 },
        "measurement": { "enum": ["level", "distance", "non-contact radar"] },
        "minimumAngleDeg": { "type": "number", "minimum": -3600, "maximum": 3600 },
        "minimumHeight": { "type": "number", "minimum": 0, "maximum": 100 },
        "mode": { "enum": ["low", "high"] },
        "mountSpan": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "positionCount": { "type": "integer", "minimum": 2, "maximum": 16 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "range": { "$ref": "#/$defs/rangeValue" },
        "running": { "type": "boolean" },
        "sensorType": { "enum": ["switch", "discrete", "analog"] },
        "showSupport": { "type": "boolean" },
        "size": { "$ref": "#/$defs/scaleVector" },
        "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "stroke": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "style": { "enum": ["pushbutton", "mushroom", "emergency", "selector", "toggle"] },
        "supportHeight": { "type": "number", "minimum": 0, "maximum": 100 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "travel": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "travelAxis": { "enum": ["x", "y", "z"] },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "equipment": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/symbolicName" },
        "type": {
          "enum": [
            "motor", "conveyor", "box", "photoeye", "switch", "indicator",
            "pump", "fan", "pusher", "tank", "levelSensor",
            "radarLevelSensor", "pipe", "rotarySwitch", "liftTable", "valve",
            "drillPress", "robotArm", "rollerShutter", "rotaryTable", "machine",
            "palletLoad", "containerReceiver", "toteFiller", "toteCapper",
            "toteLabeler", "toteVision", "meteringSkid", "sizeSensorBank"
          ]
        },
        "label": { "$ref": "#/$defs/displayText" },
        "position": { "$ref": "#/$defs/transformVector" },
        "rotation": { "$ref": "#/$defs/transformVector" },
        "scale": { "$ref": "#/$defs/scaleVector" },
        "config": { "$ref": "#/$defs/equipmentConfig" }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": ["name", "type", "owner", "initial"],
      "properties": {
        "name": { "$ref": "#/$defs/symbolicName" },
        "type": { "enum": ["BOOL", "DINT", "REAL", "STRING"] },
        "owner": { "enum": ["PC", "PLC", "SIM"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "hidden": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "machineGuide": {
      "type": "object",
      "required": [
        "purpose",
        "startConditions",
        "normalSequence",
        "stopBehavior",
        "faultBehavior",
        "expectedObservations"
      ],
      "properties": {
        "purpose": { "$ref": "#/$defs/displayText" },
        "startConditions": { "$ref": "#/$defs/guideList" },
        "normalSequence": { "$ref": "#/$defs/guideList" },
        "stopBehavior": { "$ref": "#/$defs/guideList" },
        "faultBehavior": { "$ref": "#/$defs/guideList" },
        "expectedObservations": { "$ref": "#/$defs/guideList" }
      },
      "additionalProperties": false
    },
    "guideList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/displayText" }
    },
    "simulation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "conveyor", "conveyorStop", "conveyorPusher", "tank", "gallery",
            "booleanPanel", "sequence", "static"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/point" }
        },
        "actions": { "type": "array", "maxItems": 128 },
        "pointBindings": { "type": "array", "maxItems": 256 },
        "rules": { "type": "array", "maxItems": 256 },
        "edgeRules": { "type": "array", "maxItems": 256 }
        ,"repeatLoadSeconds": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3600
        }
      },
      "additionalProperties": true
    }
  }
}
