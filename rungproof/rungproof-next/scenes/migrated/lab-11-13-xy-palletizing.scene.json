  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: A carton is picked only at home and placed only at a valid pallet position.",
      "Inputs are simulator feedback (carton_at_pick, gantry_home, pallet_position_valid); PLC logic owns vacuum_pick, gantry_cycle, layer_complete.",
      "Test the initial state, the valid condition, and at least one missing permissive.",
      "Demo 5 counts one four-pick layer, then requires Reset. Its XY sweep illustrates the command, not a closed-loop pallet placement model."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: carton_at_pick, gantry_home, pallet_position_valid.",
        "Command the documented outputs: vacuum_pick, gantry_cycle, layer_complete.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "A carton is picked only at home and placed only at a valid pallet position."
    },
    "assetRequirements": [
      "XY gantry",
      "vacuum gripper",
      "pallet magazine",
      "carton load",
      "coordinate sensors"
    ],
    "machineGuide": {
      "purpose": "Symbolic palletizing cell: manual carton/home/pallet permissives drive XY gantry command motion and a four-pick layer count. Reset starts a new layer.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Run the simulator; enable gantry home and pallet-position valid, then present a carton.",
        "Keep the carton permissive true for at least 750 ms to count one pick. Clear it before presenting the next carton.",
        "After four picks the layer-complete lamp turns on and gantry/vacuum commands stop. Reset clears the count for a new layer."
      ],
      "stopBehavior": [
        "Removing the permissive removes PLC-owned commands.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "The three gantry axes move only while gantry_cycle is true and playback is running. Stop freezes the pose; Reset restores it.",
        "Home, carton and pallet inputs are manually supplied permissives. The sweep is a command visualization; it does not generate physical position or pick-complete feedback."
      ]
    },
